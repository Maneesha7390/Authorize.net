PORT=3001
MONGO_URI=mongodb://admin:password@localhost:27017/payment_db?authSource=admin

# Authorize.Net Credentials (Sandbox)
AUTHORIZE_NET_LOGIN_ID=your_api_login_id
AUTHORIZE_NET_TRANSACTION_KEY=your_transaction_key
AUTHORIZE_NET_SIGNATURE_KEY=your_signature_key
AUTHORIZE_NET_ENVIRONMENT=sandbox # sandbox or production

# Webhook Secret (for verification)
WEBHOOK_SIGNATURE_KEY=your_signature_key

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key

